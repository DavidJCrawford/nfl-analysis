---
interface Props {
  label: string;
  value: string | number;
  /** A result rather than a fact — blacked out when spoilers are off. */
  spoil?: boolean;
}
const { label, value, spoil = false } = Astro.props;
---
<div class="stat">
  <div class="eyebrow">{label}</div>
  <div class:list={['value num', { spoil }]}>{value}</div>
</div>

<style>
  .stat { min-width: 0; }
  .stat .value {
    font-size: clamp(1.15rem, 1.6vw, var(--ks-type-title-lg-size));
    font-weight: 300;
    color: var(--ks-ink);
    line-height: 1.2;
    margin-top: 2px;
    overflow-wrap: break-word;
    hyphens: manual;
  }
</style>
