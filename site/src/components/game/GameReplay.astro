  /* Held to the far end of the row. It used to be pushed there by the read-out
     that sat between; with that gone it has to hold its own ground. */
  .count {
    margin: 0 0 0 auto; padding-left: clamp(4px, 1vw, 14px);
    font-size: var(--ks-type-eyebrow-size); letter-spacing: 0.1em;
    color: var(--ks-instrument-muted); font-variant-numeric: var(--f1-numeric);
  }

  @media (max-width: 720px) {
    .bug { max-width: 100%; }
  }

  /* A landscape phone gives this dialog 390px of height, and the furniture was
     taking 68% of it — the bug alone stood 134px tall, exactly as it does on a
     1440x900 desktop, which left the field 125. Everything here is the same
     object drawn smaller, nothing is dropped: a scoreboard with a piece
     missing is worse than a small one. */
  /* Standing up, the field is as wide as the screen and its own proportions
     then fix its height — so there is slack the field cannot use, about 300px
     of it on a phone. Centred, the field floated in the middle of that with
     the bug a long way beneath it. Sat at the bottom of its row it meets the
     bug, and the slack becomes one quiet margin under the close key rather
     than two gaps inside the picture. */
  @media (max-aspect-ratio: 4 / 5) {
    .field-wrap { align-items: flex-end; }
    .dd { font-size: var(--ks-type-ui-size); }
  }

  @media (max-height: 560px) {
