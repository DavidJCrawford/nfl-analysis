---
/** Two clubs, side by side.
 *
 *  One page for all 496 pairs rather than 496 pages, because the player
 *  comparison next door cannot be pre-rendered at all — 1.5 million pairs —
 *  and two features that do the same thing should not be built two different
 *  ways. The pair is in the query string, so a comparison is still a link
 *  somebody can send.
 *
 *  The board is dark because the replay is: on this site a black panel means
 *  an instrument, something being read rather than something being said, and
 *  a club's colours only look like its colours against one.
 */
import Base from '@layouts/Base.astro';
import { getTeams, getTeamOrder } from '@lib/data';
import { u } from '@lib/url';
import '@styles/compare.css';

const teams = getTeams();
const order = getTeamOrder();
---
<Base title="Compare clubs" description="Two NFL clubs' seasons side by side — offence, defence and discipline." bare>
  <div class="stage">
    <a class="stage-close" href={u('/teams/')} data-close>Close</a>
    <div class="stage-in">
      <header class="stage-head">
        <p class="stage-eyebrow">Season side by side</p>
        <h1 class="stage-title">Compare clubs</h1>
      </header>

      <div class="board" data-compare>
        <form class="picker" data-picker>
          <label class="pick">
            <span class="plabel">First club</span>
            <select name="a" data-a>
              {order.map((abbr) => <option value={abbr}>{teams[abbr]!.name}</option>)}
            </select>
          </label>
          <button class="swap" type="button" data-swap aria-label="Swap the two clubs">⇄</button>
          <label class="pick">
            <span class="plabel">Second club</span>
            <select name="b" data-b>
              {order.map((abbr) => <option value={abbr}>{teams[abbr]!.name}</option>)}
            </select>
          </label>
          <button class="go" type="submit">Compare</button>
        </form>

        <div data-head></div>
        <div data-rows></div>
        <p class="state" data-state>Pick two clubs.</p>
      </div>
    </div>
  </div>

  <noscript>
    <div class="stage">
      <p class="state">
        This comparison is drawn in the browser, which is the one thing on this
        site that is. Every club's own numbers are on its page —
        <a href={u('/teams/')}>the clubs are here</a>.
      </p>
    </div>
  </noscript>
</Base>

<script>
  import { clubSections, drawSections, legible, pickColours } from '@lib/compare';
  import { u } from '@lib/url';

  const board = document.querySelector<HTMLElement>('[data-compare]')!;
  const form = board.querySelector<HTMLFormElement>('[data-picker]')!;
  const selA = board.querySelector<HTMLSelectElement>('[data-a]')!;
  const selB = board.querySelector<HTMLSelectElement>('[data-b]')!;
  const head = board.querySelector<HTMLElement>('[data-head]')!;
  const rows = board.querySelector<HTMLElement>('[data-rows]')!;
  const state = board.querySelector<HTMLElement>('[data-state]')!;

  let data: Record<string, any> | null = null;

  const record = (t: any) => `${t.w}–${t.l}${t.t ? `–${t.t}` : ''}`;

  function side(t: any, which: 'a' | 'b', colour: string): HTMLAnchorElement {
    const box = document.createElement('a');
    box.className = `who ${which}`;
    box.href = u(`/teams/${t.abbr}/`);
    box.style.setProperty('--team', colour);
    box.style.setProperty('--team-lit', legible(colour));

    const img = document.createElement('img');
    img.src = u(`/logos/sm/${t.abbr}.webp`);
    img.alt = ''; img.width = 64; img.height = 64;

    const text = document.createElement('span');
    text.className = 'wtext';
    const nick = document.createElement('span');
    nick.className = 'wnick';
    nick.textContent = t.nick;
    const sub = document.createElement('span');
    sub.className = 'wsub';
    sub.textContent = `${t.name.replace(` ${t.nick}`, '')} · ${record(t)}`;
    text.append(nick, sub);

    // Crest on the outside, name toward the middle: for the left-hand club
    // that means text first. Done by order rather than with row-reverse,
    // which would also flip which end `flex-end` refers to.
    if (which === 'a') box.append(text, img); else box.append(img, text);
    return box;
  }

  function header(a: any, b: any, ca: string, cb: string): void {
    const wrap = document.createElement('div');
    wrap.className = 'versus';
    const vs = document.createElement('span');
    vs.className = 'vs';
    vs.textContent = 'v';
    wrap.append(side(a, 'a', ca), vs, side(b, 'b', cb));
    head.replaceChildren(wrap);
  }

  const close = document.querySelector<HTMLAnchorElement>('[data-close]')!;
  close.addEventListener('click', (e) => {
    // Back, when there is a back on this site to go to — a reader who opened
    // this from a club page expects to land on it again, not on the index.
    if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) {
      e.preventDefault();
      history.back();
    }
  });

  function paint(ka: string, kb: string): void {
    if (!data) return;
    const a = data[ka], b = data[kb];
    if (!a || !b) { state.textContent = 'Those are not two clubs.'; state.hidden = false; return; }
    if (ka === kb) {
      head.replaceChildren(); rows.replaceChildren();
      state.textContent = 'That is the same club twice. Pick another.';
      state.hidden = false;
      return;
    }
    state.hidden = true;
    selA.value = ka; selB.value = kb;
    // Two of the league's navy blues would otherwise draw both sides of every
    // row in the same colour.
    const [ca, cb] = pickColours(a.color, a.color2, b.color, b.color2);
    header(a, b, ca, cb);
    rows.replaceChildren(drawSections(clubSections(a, b), ca, cb));
    close.href = u(`/teams/${a.abbr}/`);
    document.title = `${a.nick} v ${b.nick} · NFL Analysis`;
  }

  function fromUrl(): [string, string] | null {
    const q = new URLSearchParams(location.search);
    const a = q.get('a'), b = q.get('b');
    return a && b ? [a.toUpperCase(), b.toUpperCase()] : null;
  }

  function go(a: string, b: string, push = true): void {
    if (push) history.pushState({ a, b }, '', `?a=${a}&b=${b}`);
    paint(a, b);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); go(selA.value, selB.value); });
  board.querySelector('[data-swap]')!.addEventListener('click', () => {
    const a = selA.value, b = selB.value;
    if (fromUrl()) go(b, a); else { selA.value = b; selB.value = a; }
  });
  addEventListener('popstate', () => { const p = fromUrl(); if (p) paint(p[0], p[1]); });

  (async () => {
    try {
      const r = await fetch(u('/data/compare-teams.json'));
      data = (await r.json()).teams;
    } catch {
      state.textContent = 'The numbers could not be loaded.';
      return;
    }
    const pair = fromUrl();
    if (pair) go(pair[0], pair[1], false);
    else {
      selA.value = 'KC'; selB.value = 'PHI';
      state.textContent = 'Pick two clubs.';
    }
  })();
</script>

<style>
  /* The whole screen is in src/styles/compare.css, which is global because the
     board is built by the script above and carries no scope attribute. */
</style>
