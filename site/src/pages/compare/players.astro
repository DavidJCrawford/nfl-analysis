---
/** Two players, side by side.
 *
 *  The pair is in the query string and the numbers are fetched, because this
 *  is the comparison that cannot be pre-rendered: 1,743 players make
 *  1.5 million pairs, and holding them to matching positions still leaves
 *  about 198,000.
 *
 *  Only the statistics both men have are drawn. A quarterback and a
 *  cornerback share none, and 412 passing yards set against a blank is not a
 *  comparison — the page says so and names what each of them has instead.
 */
import Base from '@layouts/Base.astro';
import { getTeams } from '@lib/data';
import { u } from '@lib/url';
import '@styles/compare.css';

const teams = getTeams();
// Thirty-two clubs of colour, inlined: the alternative is making every reader
// fetch the whole club payload to draw two bars in the right red.
const palette = Object.fromEntries(
  Object.entries(teams).map(([a, t]) => [a, [t.color, t.color2, t.nick]]),
);
---
<Base title="Compare players" description="Two NFL players' seasons side by side." bare>
  <div class="stage">
    <a class="stage-close" href={u('/players/')} data-close>Close</a>
    <div class="stage-in">
      <header class="stage-head">
        <p class="stage-eyebrow">Season side by side</p>
        <h1 class="stage-title">Compare players</h1>
      </header>

      <div class="board" data-compare data-palette={JSON.stringify(palette)}>
        <form class="picker" data-picker>
          <div class="pick">
            <span class="plabel" id="lab-a">First player</span>
            <div class="combo">
              <input data-a role="combobox" aria-autocomplete="list" aria-expanded="false"
                     aria-controls="sug-a" aria-labelledby="lab-a"
                     autocomplete="off" placeholder="Start typing a name" />
              <ul class="sug" id="sug-a" role="listbox" aria-label="Players" hidden></ul>
            </div>
          </div>
          <button class="swap" type="button" data-swap aria-label="Swap the two players">⇄</button>
          <div class="pick">
            <span class="plabel" id="lab-b">Second player</span>
            <div class="combo">
              <input data-b role="combobox" aria-autocomplete="list" aria-expanded="false"
                     aria-controls="sug-b" aria-labelledby="lab-b"
                     autocomplete="off" placeholder="Start typing a name" />
              <ul class="sug" id="sug-b" role="listbox" aria-label="Players" hidden></ul>
            </div>
          </div>
          <button class="go" type="submit">Compare</button>
        </form>

        <div data-head></div>
        <div data-rows></div>
        <p class="state" data-state>Loading the squads…</p>
      </div>
    </div>
  </div>

  <noscript>
    <div class="stage">
      <p class="state">
        This comparison is drawn in the browser, which is the one thing on this
        site that is. Every player's own numbers are on his page —
        <a href={u('/players/')}>the players are here</a>.
      </p>
    </div>
  </noscript>
</Base>

<script>
  import { personSections, drawSections, legible, pickColours, sharedGroups } from '@lib/compare';
  import { u } from '@lib/url';

  const board = document.querySelector<HTMLElement>('[data-compare]')!;
  const palette: Record<string, [string, string, string]> = JSON.parse(board.dataset.palette || '{}');
  const form = board.querySelector<HTMLFormElement>('[data-picker]')!;
  const head = board.querySelector<HTMLElement>('[data-head]')!;
  const rows = board.querySelector<HTMLElement>('[data-rows]')!;
  const state = board.querySelector<HTMLElement>('[data-state]')!;
  const close = document.querySelector<HTMLAnchorElement>('[data-close]')!;

  let people: Record<string, any> = {};
  let sorted: any[] = [];

  close.addEventListener('click', (e) => {
    // Back, when there is a back on this site to go to — a reader who opened
    // this from a player's page expects to land on it again.
    if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) {
      e.preventDefault();
      history.back();
    }
  });

  /* ── The combobox ──────────────────────────────────────────────────────────
     Built rather than borrowed. A <select> of 1,743 is unusable and the native
     <datalist> this replaced is an ordinary text box until you type — next to
     the clubs page's real dropdowns it read as a field that had failed. This
     opens on focus, shows faces, and answers the arrow keys. */
  function combobox(input: HTMLInputElement, list: HTMLUListElement, onPick: () => void) {
    let hits: any[] = [];
    let at = -1;
    let chosen: string | null = null;

    const shut = () => {
      list.hidden = true; at = -1;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
    };

    function row(p: any, n: number): HTMLLIElement {
      const li = document.createElement('li');
      li.id = `${list.id}-${n}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(n === at));
      if (p.face) {
        const img = document.createElement('img');
        img.className = 'sface'; img.src = u(`/faces/${p.id}.webp`);
        img.alt = ''; img.width = 28; img.height = 28; img.loading = 'lazy';
        li.append(img);
      } else {
        const s = document.createElement('span'); s.className = 'sface'; li.append(s);
      }
      const nm = document.createElement('span');
      nm.className = 'sname'; nm.textContent = p.name;
      const sub = document.createElement('span');
      sub.className = 'ssub';
      sub.textContent = `${palette[p.team]?.[2] ?? p.team}${p.pos ? ` · ${p.pos}` : ''}`;
      li.append(nm, sub);
      // mousedown, not click: blur fires first on click and would shut the
      // list out from under the pointer.
      li.addEventListener('mousedown', (e) => { e.preventDefault(); take(n); });
      return li;
    }

    function open(): void {
      const q = input.value.trim().toLowerCase();
      hits = (q
        ? sorted.filter((p) => p.name.toLowerCase().includes(q)
            || p.team.toLowerCase() === q || (p.pos ?? '').toLowerCase() === q)
        : sorted).slice(0, 40);
      if (!hits.length) {
        const li = document.createElement('li');
        li.className = 'snone'; li.textContent = 'Nobody by that name.';
        list.replaceChildren(li);
      } else {
        list.replaceChildren(...hits.map(row));
      }
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function mark(): void {
      [...list.children].forEach((li, n) => li.setAttribute('aria-selected', String(n === at)));
      const el = list.children[at] as HTMLElement | undefined;
      if (el) { el.scrollIntoView({ block: 'nearest' }); input.setAttribute('aria-activedescendant', el.id); }
    }

    function take(n: number): void {
      const p = hits[n];
      if (!p) return;
      chosen = p.id;
      input.value = p.name;
      shut();
      onPick();
    }

    input.addEventListener('focus', open);
    input.addEventListener('input', () => { chosen = null; open(); });
    input.addEventListener('blur', () => setTimeout(shut, 120));
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (list.hidden) return open();
        at = e.key === 'ArrowDown'
          ? Math.min(at + 1, hits.length - 1)
          : Math.max(at - 1, 0);
        mark();
      } else if (e.key === 'Enter') {
        if (!list.hidden && at >= 0) { e.preventDefault(); take(at); }
      } else if (e.key === 'Escape') {
        shut();
      }
    });

    return {
      /** The id, if one was picked from the list; otherwise whatever an
       *  unambiguous name match gives. */
      id(): string | null {
        if (chosen) return chosen;
        const v = input.value.trim().toLowerCase();
        if (!v) return null;
        const exact = sorted.filter((p) => p.name.toLowerCase() === v);
        return exact.length === 1 ? exact[0].id : null;
      },
      set(p: any) { chosen = p.id; input.value = p.name; },
    };
  }

  const boxA = combobox(board.querySelector('[data-a]')!, board.querySelector('#sug-a')!, () => {});
  const boxB = combobox(board.querySelector('[data-b]')!, board.querySelector('#sug-b')!, () => {});

  function side(p: any, which: 'a' | 'b', colour: string): HTMLAnchorElement {
    const box = document.createElement('a');
    box.className = `who ${which}`;
    box.href = u(`/players/${p.id}/`);
    box.style.setProperty('--team', colour);
    box.style.setProperty('--team-lit', legible(colour));

    let mark: HTMLElement;
    if (p.face) {
      const img = document.createElement('img');
      img.className = 'face'; img.src = u(`/faces/${p.id}.webp`);
      img.alt = ''; img.width = 64; img.height = 64;
      mark = img;
    } else {
      mark = document.createElement('span');
      mark.className = 'face';
    }

    const text = document.createElement('span');
    text.className = 'wtext';
    const nm = document.createElement('span');
    nm.className = 'wnick'; nm.textContent = p.name;
    const sub = document.createElement('span');
    sub.className = 'wsub';
    const club = palette[p.team]?.[2] ?? p.team;
    sub.textContent = `${club}${p.pos ? ` · ${p.pos}` : ''}${p.no != null ? ` · #${p.no}` : ''}`;
    text.append(nm, sub);

    if (which === 'a') box.append(text, mark); else box.append(mark, text);
    return box;
  }

  function colours(a: any, b: any): [string, string] {
    const [am, aa] = palette[a.team] ?? ['#888', '#bbb'];
    const [bm, ba] = palette[b.team] ?? ['#888', '#bbb'];
    // Team-mates would otherwise be drawn in one colour throughout.
    if (a.team === b.team) return [am, aa && aa !== am ? aa : '#c9c9c9'];
    return pickColours(am, aa, bm, ba);
  }

  function paint(ka: string, kb: string): void {
    const a = people[ka], b = people[kb];
    if (!a || !b) {
      head.replaceChildren(); rows.replaceChildren();
      state.textContent = 'Those are not two players.'; state.hidden = false; return;
    }
    if (ka === kb) {
      head.replaceChildren(); rows.replaceChildren();
      state.textContent = 'That is the same player twice. Pick another.'; state.hidden = false; return;
    }
    boxA.set(a); boxB.set(b);
    const [ca, cb] = colours(a, b);

    const wrap = document.createElement('div');
    wrap.className = 'versus';
    const vs = document.createElement('span');
    vs.className = 'vs'; vs.textContent = 'v';
    wrap.append(side(a, 'a', ca), vs, side(b, 'b', cb));
    head.replaceChildren(wrap);

    const shared = sharedGroups(a, b);
    if (!shared.length) {
      rows.replaceChildren();
      // Honest rather than empty: these two genuinely have no number in
      // common, and the page should say what kind each of them has.
      const say = (p: any) => {
        const g = Object.keys(p.stats);
        return g.length ? g.join(', ') : 'nothing recorded yet';
      };
      state.innerHTML =
        `These two have no statistic in common, so there is nothing to draw. ` +
        `<a href="${u(`/players/${a.id}/`)}">${a.name}</a> has ${say(a)}; ` +
        `<a href="${u(`/players/${b.id}/`)}">${b.name}</a> has ${say(b)}.`;
      state.hidden = false;
    } else {
      state.hidden = true;
      rows.replaceChildren(drawSections(personSections(a, b), ca, cb));
    }
    close.href = u(`/players/${a.id}/`);
    document.title = `${a.name} v ${b.name} · NFL Analysis`;
  }

  function fromUrl(): [string, string] | null {
    const q = new URLSearchParams(location.search);
    const a = q.get('a'), b = q.get('b');
    return a && b ? [a, b] : null;
  }

  function go(a: string, b: string, push = true): void {
    if (push) history.pushState({ a, b }, '', `?a=${a}&b=${b}`);
    paint(a, b);
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = boxA.id(), b = boxB.id();
    if (!a || !b) {
      state.textContent = 'Pick both names from the list.'; state.hidden = false; return;
    }
    go(a, b);
  });
  board.querySelector('[data-swap]')!.addEventListener('click', () => {
    const a = boxA.id(), b = boxB.id();
    if (a && b) go(b, a);
  });
  addEventListener('popstate', () => { const p = fromUrl(); if (p) paint(p[0], p[1]); });

  (async () => {
    try {
      const r = await fetch(u('/data/compare-players.json'));
      people = (await r.json()).players;
    } catch {
      state.textContent = 'The numbers could not be loaded.';
      return;
    }
    // Busiest first, so an empty box opens on people somebody might want.
    sorted = Object.values(people).sort((x: any, y: any) => y.games - x.games || x.name.localeCompare(y.name));
    const pair = fromUrl();
    if (pair) go(pair[0], pair[1], false);
    else { state.textContent = 'Pick two players.'; state.hidden = false; }
  })();
</script>

<style>
  /* The whole screen is in src/styles/compare.css, which is global because the
     board is built by the script above and carries no scope attribute. */
</style>
