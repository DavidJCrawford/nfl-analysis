---
/** Two players, side by side.
 *
 *  The pair is in the query string and the numbers are fetched, because this
 *  is the comparison that cannot be pre-rendered: 1,743 players make
 *  1.5 million pairs, and holding them to matching positions still leaves
 *  about 198,000 pages.
 *
 *  Only the statistics both men have are drawn. A quarterback and a
 *  cornerback share none, and 412 passing yards set against a blank is not a
 *  comparison — the page says so and offers the obvious alternative instead.
 */
import Base from '@layouts/Base.astro';
import { getTeams } from '@lib/data';
import { u } from '@lib/url';
import '@styles/compare.css';

const teams = getTeams();
// Thirty-two clubs of colour, inlined: the alternative is making every reader
// fetch the whole club payload to draw two bars in the right red.
const palette = Object.fromEntries(
  Object.entries(teams).map(([a, t]) => [a, [t.color, t.color2, t.nick]]),
);
---
<Base title="Compare players" description="Two NFL players' seasons side by side.">
  <div class="wrap section intro">
    <p class="eyebrow">Season side by side</p>
    <h1 class="headline" style="margin-top:.2em">Compare players</h1>
  </div>

  <div class="wrap">
    <div class="board" data-compare data-palette={JSON.stringify(palette)}>
      <form class="picker" data-picker>
        <label class="pick">
          <span class="plabel">First player</span>
          <input name="a" data-a list="who-a" autocomplete="off" placeholder="Start typing a name" />
          <datalist id="who-a"></datalist>
        </label>
        <button class="swap" type="button" data-swap aria-label="Swap the two players">⇄</button>
        <label class="pick">
          <span class="plabel">Second player</span>
          <input name="b" data-b list="who-b" autocomplete="off" placeholder="Start typing a name" />
          <datalist id="who-b"></datalist>
        </label>
        <button class="go" type="submit">Compare</button>
      </form>

      <div data-head></div>
      <div data-rows></div>
      <p class="state" data-state>Loading the squads…</p>
    </div>
  </div>

  <noscript>
    <div class="wrap section">
      <p class="lead measure">
        This comparison is drawn in the browser, which is the one thing on this
        site that is. Every player's own numbers are on his page —
        <a href={u('/players/')}>the players are here</a>.
      </p>
    </div>
  </noscript>
</Base>

<script>
  import { personSections, drawSections, legible, pickColours, sharedGroups } from '@lib/compare';
  import { u } from '@lib/url';

  const board = document.querySelector<HTMLElement>('[data-compare]')!;
  const palette: Record<string, [string, string, string]> = JSON.parse(board.dataset.palette || '{}');
  const form = board.querySelector<HTMLFormElement>('[data-picker]')!;
  const inA = board.querySelector<HTMLInputElement>('[data-a]')!;
  const inB = board.querySelector<HTMLInputElement>('[data-b]')!;
  const listA = board.querySelector<HTMLDataListElement>('#who-a')!;
  const listB = board.querySelector<HTMLDataListElement>('#who-b')!;
  const head = board.querySelector<HTMLElement>('[data-head]')!;
  const rows = board.querySelector<HTMLElement>('[data-rows]')!;
  const state = board.querySelector<HTMLElement>('[data-state]')!;

  let people: Record<string, any> = {};
  /** "Patrick Mahomes (KC, QB)" -> id. What the datalist offers and what a
   *  typed entry is matched against, since a name alone is not unique —
   *  the league has several Josh Allens. */
  let byLabel = new Map<string, string>();

  const label = (p: any) => `${p.name} (${p.team}${p.pos ? `, ${p.pos}` : ''})`;

  function fillLists(): void {
    const opts = Object.values(people)
      .sort((x: any, y: any) => x.name.localeCompare(y.name))
      .map((p: any) => { const o = document.createElement('option'); o.value = label(p); return o; });
    listA.replaceChildren(...opts.map((o) => o.cloneNode() as HTMLOptionElement));
    listB.replaceChildren(...opts);
  }

  function side(p: any, which: 'a' | 'b', colour: string): HTMLAnchorElement {
    const box = document.createElement('a');
    box.className = `who ${which}`;
    box.href = u(`/players/${p.id}/`);
    box.style.setProperty('--team', colour);
    box.style.setProperty('--team-lit', legible(colour));

    let mark: HTMLElement;
    if (p.face) {
      const img = document.createElement('img');
      img.className = 'face'; img.src = u(`/faces/${p.id}.webp`);
      img.alt = ''; img.width = 64; img.height = 64;
      mark = img;
    } else {
      mark = document.createElement('span');
      mark.className = 'face';
    }

    const text = document.createElement('span');
    text.className = 'wtext';
    const nm = document.createElement('span');
    nm.className = 'wnick';
    nm.textContent = p.name;
    const sub = document.createElement('span');
    sub.className = 'wsub';
    const club = palette[p.team]?.[2] ?? p.team;
    sub.textContent = `${club}${p.pos ? ` · ${p.pos}` : ''}${p.no != null ? ` · #${p.no}` : ''}`;
    text.append(nm, sub);

    if (which === 'a') box.append(text, mark); else box.append(mark, text);
    return box;
  }

  function colours(a: any, b: any): [string, string] {
    const [am, aa] = palette[a.team] ?? ['#888', '#bbb'];
    const [bm, ba] = palette[b.team] ?? ['#888', '#bbb'];
    // Team-mates would otherwise be drawn in one colour throughout.
    if (a.team === b.team) return [am, aa && aa !== am ? aa : '#c9c9c9'];
    return pickColours(am, aa, bm, ba);
  }

  function paint(ka: string, kb: string): void {
    const a = people[ka], b = people[kb];
    if (!a || !b) {
      head.replaceChildren(); rows.replaceChildren();
      state.textContent = 'Those are not two players.'; state.hidden = false; return;
    }
    if (ka === kb) {
      head.replaceChildren(); rows.replaceChildren();
      state.textContent = 'That is the same player twice. Pick another.'; state.hidden = false; return;
    }
    inA.value = label(a); inB.value = label(b);
    const [ca, cb] = colours(a, b);

    const wrap = document.createElement('div');
    wrap.className = 'versus';
    const vs = document.createElement('span');
    vs.className = 'vs'; vs.textContent = 'v';
    wrap.append(side(a, 'a', ca), vs, side(b, 'b', cb));
    head.replaceChildren(wrap);

    const shared = sharedGroups(a, b);
    if (!shared.length) {
      rows.replaceChildren();
      // Honest rather than empty: these two genuinely have no number in
      // common, and the page should say which kind of number each of them has.
      const say = (p: any) => {
        const g = Object.keys(p.stats);
        return g.length ? g.join(', ') : 'nothing recorded yet';
      };
      state.innerHTML =
        `These two have no statistic in common, so there is nothing to draw. ` +
        `<a href="${u(`/players/${a.id}/`)}">${a.name}</a> has ${say(a)}; ` +
        `<a href="${u(`/players/${b.id}/`)}">${b.name}</a> has ${say(b)}.`;
      state.hidden = false;
    } else {
      state.hidden = true;
      rows.replaceChildren(drawSections(personSections(a, b), ca, cb));
    }
    document.title = `${a.name} v ${b.name} · NFL Analysis`;
  }

  const idOf = (raw: string): string | null => {
    const v = raw.trim();
    if (people[v]) return v;                        // already an id
    if (byLabel.has(v)) return byLabel.get(v)!;
    const hit = Object.values(people).find((p: any) => p.name.toLowerCase() === v.toLowerCase());
    return hit ? (hit as any).id : null;
  };

  function fromUrl(): [string, string] | null {
    const q = new URLSearchParams(location.search);
    const a = q.get('a'), b = q.get('b');
    return a && b ? [a, b] : null;
  }

  function go(a: string, b: string, push = true): void {
    if (push) history.pushState({ a, b }, '', `?a=${a}&b=${b}`);
    paint(a, b);
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = idOf(inA.value), b = idOf(inB.value);
    if (!a || !b) {
      state.textContent = 'Pick both names from the list.';
      state.hidden = false;
      return;
    }
    go(a, b);
  });
  board.querySelector('[data-swap]')!.addEventListener('click', () => {
    const a = idOf(inA.value), b = idOf(inB.value);
    if (a && b) go(b, a); else { const v = inA.value; inA.value = inB.value; inB.value = v; }
  });
  addEventListener('popstate', () => { const p = fromUrl(); if (p) paint(p[0], p[1]); });

  (async () => {
    try {
      const r = await fetch(u('/data/compare-players.json'));
      people = (await r.json()).players;
    } catch {
      state.textContent = 'The numbers could not be loaded.';
      return;
    }
    byLabel = new Map(Object.values(people).map((p: any) => [label(p), p.id]));
    fillLists();
    const pair = fromUrl();
    if (pair) go(pair[0], pair[1], false);
    else { state.textContent = 'Pick two players.'; state.hidden = false; }
  })();
</script>

<style>
  /* The rest is in src/styles/compare.css — global, because the board is built
     by the script above and carries no scope attribute. */
  .intro { padding-bottom: clamp(12px, 1.6vw, 20px); }
</style>
