---
import { Font } from 'astro:assets';
import { u } from '@lib/url';
import '@styles/base.css';

interface Props {
  title: string;
  description?: string;
  /** No masthead. For a page that is a screen rather than a document — the
   *  comparison boards, which are the replay's idea applied to two seasons:
   *  a dark stage with one way out of it, in the top right corner. */
  bare?: boolean;
}
const {
  title,
  description = 'The NFL season, game by game — one permanent page each.',
  bare = false,
} = Astro.props;

const NAV = [
  { href: '/teams/', label: 'Teams' },
  { href: '/players/', label: 'Players' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NFL Analysis</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--ks-font" preload />
    <Font cssVariable="--ks-font-display" preload />
    <Font cssVariable="--ks-mono" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    {!bare && (
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="wordmark plain" href={u('/')}>
          {/* Decorative: the words beside it say the same thing. Cropped to
              its ink and cut to 64px on the long edge — 2.4KB against the
              500px original's 18. */}
          <img class="shield" src={u('/nfl.webp')} alt="" width="47" height="64" />
          <span>NFL Analysis</span>
        </a>
        <nav aria-label="Sections">
          {NAV.map((item) => (
            <a class="plain nav-link" href={u(item.href)}
               aria-current={path.startsWith(u(item.href)) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
      <hr class="rule" />
    </header>
    )}

    <main id="main"><slot /></main>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 10;
    background: var(--ks-ink); color: var(--ks-paper);
    padding: 10px 16px; border-radius: var(--ks-radius-sm);
  }
  .skip:focus { left: 12px; top: 12px; }

  .masthead-inner {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 24px; padding-block: 20px; flex-wrap: wrap;
  }
  /* Baseline, not centre, and the mark opted out of it. The masthead row
     aligns its two halves on their baselines, and a flex box takes its
     baseline from its first baseline-aligned item — which was the image, whose
     baseline is its bottom edge. So the mark was dragging the row's baseline
     down with it, and the masthead grew by a pixel as the mark grew. With the
     words supplying the baseline and the mark centred against them, the row is
     the same height whatever size the mark is. */
  .wordmark { display: inline-flex; align-items: baseline; gap: 0.42em; }
  /* The shield carries its own lettering, so it needs height to be anything
     at all — at the cap height of the words beside it the NFL inside was four
     pixels tall and simply a smudge.
     What the row cares about is not how tall the mark is drawn but how tall
     its margin box is: anything up to the 33px line box it sits in is free.
     So it is drawn at 36 and given back four, which leaves 32 for the layout
     and lets the other four fall into the 20px of padding the masthead has
     above and below — space that was doing nothing. In em throughout, so the
     whole arrangement follows the wordmark if that ever changes. */
  .shield {
    height: 1.8em; width: auto; flex: none; align-self: center;
    margin-block: -0.1em;
  }
  .wordmark {
    font-size: var(--ks-type-subhead-size);
    letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 500; color: var(--ks-ink);
  }
  nav { display: flex; gap: clamp(14px, 2vw, 26px); }
  .nav-link {
    font-size: var(--ks-type-ui-size); letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ks-text-muted);
  }
  .nav-link[aria-current='page'] {
    color: var(--ks-ink); border-bottom: 1px solid var(--ks-ink);
  }
</style>
